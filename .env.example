# Variables de entorno — gestor Django SaaS
# Copiar a .env y ajustar antes de levantar

# --- General ---
DJANGO_SECRET_KEY=cambia-esta-clave-por-algo-seguro-y-aleatorio
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- PostgreSQL (compartido por todos los servicios) ---
POSTGRES_DB=gestor_saas
POSTGRES_USER=gestor
POSTGRES_PASSWORD=gestor123
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- URLs internas de los servicios (DNS de Docker Compose) ---
AUTH_SERVICE_URL=http://auth-service:8001
CATALOG_SERVICE_URL=http://catalog-service:8002
SALES_SERVICE_URL=http://sales-service:8003
